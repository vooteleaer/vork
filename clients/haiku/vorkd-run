#!/bin/sh
# vorkd as the launch_daemon job runs it on Haiku: its output in
# ~/config/var/log/vork/vorkd.log (kept under 10 MB; the older half moves
# to vorkd.log.1), and started again 10 s after it ends. launch_daemon
# keeps a job's output nowhere and doesn't restart a job, so a watchdog's
# last words were lost and vork stayed down (2026-11-12).
HERE=$(cd "$(dirname "$0")" && pwd)
L="$HOME/config/var/log/vork"
mkdir -p "$L"
while true; do
	if [ "$(stat -c %s "$L/vorkd.log" 2>/dev/null || echo 0)" -gt 10000000 ]; then
		mv -f "$L/vorkd.log" "$L/vorkd.log.1"
	fi
	"$HERE/vorkd" >> "$L/vorkd.log" 2>&1
	echo "vorkd ended with $?: starting it again in 10 s ($(date))" >> "$L/vorkd.log"
	sleep 10
done
