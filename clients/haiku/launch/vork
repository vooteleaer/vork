# vØrk as the user's launch_daemon jobs: the vØrk node, and the vork daemon
# after it. A package puts this in data/user_launch/ (every user) with its
# own paths; by hand, copy it to ~/config/settings/launch/vork with APP
# replaced by the app folder, then log in again.

job x-vnd.vork-node {
	launch APP/bin/vork run
}

job x-vnd.retifs-daemon {
	launch APP/bin/vorkd
	requires x-vnd.vork-node
}
