/*
 * vork for Haiku: the app's resources (signature, one instance, version).
 */

resource app_signature "application/x-vnd.retifs-desktop";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 0,
	minor  = 1,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "vork",
	long_info = "vork: status and settings of this device's vork and Reticulum"
};

/* vork: links (invitations, libraries) open here: the link in the
 * Announces tab, joined only when the user says so. */
resource file_types message {
	"types" = "application/x-vnd.Be.URL.vork"
};
