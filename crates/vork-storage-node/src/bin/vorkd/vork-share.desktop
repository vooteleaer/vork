[Desktop Entry]
Type=Service
MimeType=application/octet-stream;inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Protocols=file
Actions=share

# "Share with vork…" in Dolphin: the selected files, or one folder, inside
# a vork folder (~/vork/<library>) become a share of their own (ADR-0021).
[Desktop Action share]
Name=Share with vork…
Icon=emblem-shared
Exec=sh -c 'out=$(vork share path "$@" 2>&1) && kdialog --title "Shared with vork" --msgbox "$out" || kdialog --title "Not shared" --error "$out"' vork-share %F
