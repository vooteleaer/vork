#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # A new node: its configuration and identity (an existing one is kept),
    # with the interface on, so programs reach vØrk addresses and .vork names.
    if [ ! -e /etc/vork/vork.toml ]; then
        # A free UDP port of its own: another node behind the same router (a phone,
        # a PC) may have 51820; the router is asked to open this one.
        /usr/bin/vork init --port auto >/dev/null
        sed -i 's/^# tun = "vork0"/tun = "vork0"/' /etc/vork/vork.toml
        echo "vork: node configuration written to /etc/vork/vork.toml"
    fi
    # Whoever installs (or upgrades) it may manage the node from the vØrk window,
    # while no operators are named yet (the window runs as that user, not root).
    WHO=${SUDO_USER:-}
    if [ -z "$WHO" ] && [ -n "${PKEXEC_UID:-}" ]; then WHO=$(id -nu "$PKEXEC_UID" 2>/dev/null || true); fi
    if [ -n "$WHO" ] && [ "$WHO" != root ] && ! grep -q '^operators' /etc/vork/vork.toml; then
        if grep -q '^# operators = \["alice"\]' /etc/vork/vork.toml; then
            sed -i "s/^# operators = \[\"alice\"\]/operators = [\"$WHO\"]/" /etc/vork/vork.toml
        else
            # At the top, where no [table] has started.
            sed -i "1i operators = [\"$WHO\"]" /etc/vork/vork.toml
        fi
        echo "vork: $WHO may manage the node (operators in /etc/vork/vork.toml)"
    fi
    if command -v systemctl >/dev/null && [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable vork.service >/dev/null 2>&1 || true
        if [ -n "$2" ]; then
            systemctl try-restart vork.service >/dev/null 2>&1 || true
        else
            systemctl start vork.service >/dev/null 2>&1 || true
        fi
    fi
    command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
    if [ -z "$2" ]; then
        cat <<MSG
vØrk is installed and the node is running (vork status). Open "vØrk" from
the applications menu (it also starts in the tray at login), and link your
other devices: Devices -> Show a code, or vork link-code.
Users who may manage the node: operators in /etc/vork/vork.toml.
MSG
    fi
fi
exit 0
