#!/bin/sh
set -e
if [ "$1" = configure ] && command -v systemctl >/dev/null && [ -d /run/systemd/system ]; then
    # Started at login for every user...
    systemctl --global enable vork-storage.service >/dev/null 2>&1 || true
    # ...and now for whoever is logged in (an upgrade: started again on the new programs).
    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        u=$(id -nu "$uid" 2>/dev/null) || continue
        if [ -n "$2" ]; then
            systemctl --user -M "$u@" daemon-reload >/dev/null 2>&1 || true
            systemctl --user -M "$u@" restart vork-storage.service >/dev/null 2>&1 || true
        else
            systemctl --user -M "$u@" start vork-storage.service >/dev/null 2>&1 || true
        fi
    done
    if [ -z "$2" ]; then
        cat <<MSG
vØrk storage is installed and runs for each user from login. Its pages are
in the vØrk dashboard (vØrk window or vork web), your libraries are folders
in ~/vork, and the command is vork-storage. Your store: ~/.local/share/vork-storage
(kept when the package is removed).
MSG
    fi
fi
exit 0
