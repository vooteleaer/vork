# vØrk node as a systemd service.
#
#   install -m 755 vork /usr/local/bin/vork
#   vork init                       # writes /etc/vork/vork.toml, creates /var/lib/vork/node.key
#   install -m 644 vork.service /etc/systemd/system/vork.service
#   systemctl daemon-reload && systemctl enable --now vork
#   vork status
#
# Runs as root with only CAP_NET_ADMIN left (socket buffers past rmem_max now,
# the TUN interface later), and sees the file system read-only except its state.

[Unit]
Description=vØrk node
Documentation=https://github.com/vooteleaer/vork
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/vork run --config /etc/vork/vork.toml
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
StateDirectory=vork
# Readable by local users: their programs reach the node through api.sock and
# control.sock here; the key itself is 0600.
StateDirectoryMode=0755
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
