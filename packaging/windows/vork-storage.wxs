<!--
  vØrk storage for Windows as one MSI, apart from vØrk the network (which it
  needs): for the user installing it, no administrator. It holds vorkd, its
  pages in the vØrk dashboard (vork-web), the libraries in Explorer
  (vork-cloudfiles), the vork-storage command, and vork-storage-run, which
  keeps them running from login. Built by build-storage-msi.ps1 with WiX 5.

  Install:    double-click, or  msiexec /i vork-storage-<version>.msi /qn
  Uninstall:  Apps & features, or  msiexec /x vork-storage-<version>.msi
  The store (%LOCALAPPDATA%\vork-storage) and the %USERPROFILE%\vork
  folder are never removed.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="vØrk storage" Manufacturer="vØrk" Version="$(Version)" Language="1033" Codepage="65001" Scope="perUser"
           UpgradeCode="{9C2E7B41-5A08-4D6F-B3E2-7F1A0C8D4B65}">
    <SummaryInformation Description="vØrk storage: your files on your own devices, over vØrk" />
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer vØrk storage is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="vork_storage.ico" SourceFile="$(sys.SOURCEFILEDIR)vork.ico" />
    <Property Id="ARPPRODUCTICON" Value="vork_storage.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/vooteleaer/vork" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <!-- vØrk the network first: storage runs on its node. -->
    <Property Id="VORKSERVICE">
      <RegistrySearch Id="VorkService" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\vork" Name="ImagePath" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR VORKSERVICE" Message="vØrk storage runs on vØrk: install vØrk first (vork-&lt;version&gt;.msi)." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="vork-storage">
          <Component Id="Programs" Guid="{4E8B1F3A-27C6-4D95-A0B8-6C3D9E2F7A14}" Bitness="always64">
            <File Id="vorkd.exe" Source="$(Files)\vorkd.exe" />
            <File Id="vork_web.exe" Source="$(Files)\vork-web.exe" />
            <File Id="vork_cloudfiles.exe" Source="$(Files)\vork-cloudfiles.exe" />
            <File Id="vork_storage.exe" Source="$(Files)\vork-storage.exe" />
            <File Id="vork_storage_run.exe" Source="$(Files)\vork-storage-run.exe" />
            <File Id="LICENSE.txt" Source="$(Files)\LICENSE.txt" />
            <!-- Per user: a registry value is the component's key. -->
            <RegistryValue Root="HKCU" Key="Software\vork-storage" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            <!-- Running from login. -->
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="vork-storage" Type="string"
                           Value="&quot;[INSTALLFOLDER]vork-storage-run.exe&quot;" />
            <!-- Unversioned programs: this package's always replace what's there. -->
            <RemoveFile Id="OldPrograms" Name="*.exe" On="install" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
            <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Part="last" System="no" Action="set" Permanent="no" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="vØrk storage">
      <ComponentRef Id="Programs" />
    </Feature>

    <!-- Before files are replaced or removed: storage stopped (vorkd closes
         its store cleanly), then anything left of it ended. -->
    <SetProperty Id="StopStorage" Value="&quot;[INSTALLFOLDER]vork-storage-run.exe&quot; --stop" Before="StopStorage" Sequence="execute" />
    <CustomAction Id="StopStorage" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />
    <SetProperty Id="EndStorage" Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM vork-storage-run.exe /IM vorkd.exe /IM vork-web.exe /IM vork-cloudfiles.exe" Before="EndStorage" Sequence="execute" />
    <CustomAction Id="EndStorage" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- Removed: the libraries leave Explorer (their data stays). -->
    <SetProperty Id="Unregister" Value="&quot;[INSTALLFOLDER]vork-cloudfiles.exe&quot; --unregister --all" Before="Unregister" Sequence="execute" />
    <CustomAction Id="Unregister" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- Installed: running at once, not only from the next login. -->
    <CustomAction Id="StartStorage" FileRef="vork_storage_run.exe" ExeCommand="" Execute="immediate" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <!-- After RemoveExistingProducts, which must come first (an older
           version's removal runs these itself): an upgrade, a repair, a
           removal, or programs left running by hand. -->
      <Custom Action="StopStorage" After="RemoveExistingProducts" />
      <Custom Action="EndStorage" After="StopStorage" />
      <Custom Action="Unregister" After="EndStorage" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="StartStorage" After="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(License)" />
  </Package>
</Wix>
