# vorkd as a systemd user service.
#   cp packaging/systemd/*.service ~/.config/systemd/user/
#   systemctl --user enable --now vorkd
# Needs the vØrk node on the machine (packaging/vork.service); it reconnects
# to the node by itself.
[Unit]
Description=vork daemon (records, sync, placement)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/vorkd
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
