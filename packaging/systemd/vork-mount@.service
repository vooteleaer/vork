# One namespace as a file tree at ~/vork/<namespace>.
#   systemctl --user enable --now vork-mount@photos
# Needs fusermount3 (Debian/Ubuntu: apt install fuse3).
[Unit]
Description=vork namespace %i at ~/vork/%i
Requires=vorkd.service
After=vorkd.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p %h/vork/%i
ExecStart=%h/.cargo/bin/vork-mount %i %h/vork/%i
ExecStop=/bin/fusermount3 -u %h/vork/%i
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
